# Project Settings > Data API (or API Settings) in Supabase.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Backend only. Prefer the current sb_secret_... key when available.
# A legacy service_role JWT also works, but must never reach the browser or Git.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional legacy variable name. Leave empty when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=
