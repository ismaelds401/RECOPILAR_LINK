# Project Settings > Data API (or API Settings) in Supabase.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Backend only. Prefer the current sb_secret_... key when available.
# A legacy service_role JWT also works, but must never reach the browser or Git.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional legacy variable name. Leave empty when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 9 daily Gmail digest. Store real values only in .env locally and in
# GitHub Actions secrets; never commit a Gmail app password.
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
DIGEST_RECIPIENT_EMAILS=

# Optional digest preferences (comma-separated). Empty means no restriction.
DIGEST_CATEGORIES=
DIGEST_TAGS=
DIGEST_CITIES=
DIGEST_MODALITIES=
DIGEST_ORGANIZATIONS=
DIGEST_KEYWORDS=
DIGEST_FREE_ONLY=false
DIGEST_LOOKBACK_HOURS=48
DIGEST_MAX_EVENTS=20
DIGEST_SITE_URL=https://recopilar-link.pages.dev

